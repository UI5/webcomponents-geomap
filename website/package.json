{
  "name": "@ui5/webcomponents-geomap-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:local-cdn": "rimraf ./local-cdn && node ./build-scripts/local-cdn.mjs",
    "generate:api-reference": "rimraf ./docs/components && node ./build-scripts/api-reference-generation/index.mjs",
    "build:components": "cd ../ && npm run build",
    "build:website": "npm-run-all --sequential build:components generate:api-reference generate:local-cdn build",
    "start:website": "npm-run-all --sequential build:components generate:api-reference generate:local-cdn start",
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "playground-elements": "0.18.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^19.3.0",
    "react-splitter-light": "^1.0.3",
    "tarts": "^2.0.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "npm-run-all": "^4.1.5",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
